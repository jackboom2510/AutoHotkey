{
    "#ClickTracker": {
        "ClickTracker.ToggleTracking": {
            "description": "Initializes tracking by clearing previous data, setting tracking flags, and minimizing the GUI window.",
            "hotkeys": [
                {"key": "!t"}
            ],
            "section": "⚙️ TRACKING SETTINGS"
        },
        "ClickTracker.Track": {
            "description": "Captures and stores mouse click coordinates, along with window information on the first click during tracking.",
            "hotkeys": [
                {"key": "MButton", "condition": "StartTracking"}
            ],
            "section": "🖱️ ClickTracking"
        }
    },
    "#Macros": {
        "Send": { 
            "description": "Send specific key combinations based on the hotkey pressed.",
            "hotkeys": {
                "a": {"key": "{WheelLeft}", "condition": ["GetScriptStatus"]},
                "d": {"key": "{WheelRight}", "condition": ["GetScriptStatus"]},
                "s": {"key": "{WheelDown}", "condition": ["GetScriptStatus"]},
                "w": {"key": "{WheelUp}", "condition": ["GetScriptStatus"]},
                "!e": {"key": "!{=}", "condition": ["GetScriptStatus"]},
                "!q": {"key": "!{-}", "condition": ["GetScriptStatus"]},
                "^!e": {"key": "^{WheelUp}", "condition": ["GetScriptStatus"]},
                "^!q": {"key": "^{WheelDown}", "condition": ["GetScriptStatus"]},
                "^!s": {"key": "{PgDn}", "condition": ["GetScriptStatus"]},
                "^!w": {"key": "{PgUp}", "condition": ["GetScriptStatus"]},
                "^e": {"key": "^{=}", "condition": ["GetScriptStatus"]},
                "^q": {"key": "^{-}", "condition": ["GetScriptStatus"]},
                "!a": {"key": "{Left}", "condition": [["GetOption", 3]]},
                "!d": {"key": "{Right}", "condition": [["GetOption", 3]]},
                "!s": {"key": "{Down}", "condition": [["GetOption", 3]]},
                "!w": {"key": "{Up}", "condition": [["GetOption", 3]]},
                "XButton1 & WheelDown": {"key": "{Left}", "condition": [["GetWindowStatus", [1, "YouTube - Google Chrome"]]]},
                "XButton1 & WheelUp": {"key": "{Right}", "condition": [["GetWindowStatus", [1, "YouTube - Google Chrome"]]]},
                "!+w": {"key": "+{Home}"},
                "!+d": {"key": "+{Home}{Del}"},
                "+Space": {"key": "_", "condition": [["GetOption", 1]]},
                "+Backspace": {"key": "+^{Right}{Del}", "condition": [["GetOption", 1]]},
                "!x": {"key": ",", "condition": [["GetWindowStatus", [1, "TechSmith Camtasia 2025"]]]},
                "!z": {"key": ".", "condition": [["GetWindowStatus", [1, "TechSmith Camtasia 2025"]]]},
                "!;": {"key": "{Click}", "condition": [["GetOption", 1]]},
                "!f": {"key": "{Enter}", "condition": [["GetOption", 1]]},
                "!XButton1": {"key": "{F10}", "condition": [["GetWindowStatus", [1, "ahk_exe Code.exe"]]]},
                "!XButton2": {"key": "{F11}", "condition": [["GetWindowStatus", [1, "ahk_exe Code.exe"]]]},
                "!^i": {"key": "{WheelUp}", "condition": [["GetOption", [1]]]},
                "!^k": {"key": "{WheelDown}", "condition": [["GetOption", [1]]]}
            },
            "section": "🤖 SIMULATION"
        },
        "CycleAndExecute": {
            "args": [
                [1, [["ConfigureOneNote", [2]], ["ConfigureOneNote", [3]]]],
                [2, [["ConfigureOneNote", [1]], ["ConfigureOneNote", [2]]]],
                [3, [["ConfigureOneNote", [1]], ["ConfigureOneNote", [5]]]],
                [4, [["DynamicSet", ["moveDistance", 5]], ["DynamicSet", ["moveDistance", 15]]]]
            ],
            "description": "Toggle and execute the corresponding ConfigureOneNote function with different arguments.",
            "hotkeys": [ 
                {"key": "F21"},
                {"key": "Space", "condition": ["GetScriptStatus"]},
                {"key": "^Space", "condition": ["GetScriptStatus"]},
                {"key": "!+;", "condition": [["GetOption", 1]]}
            ],
            "section": "⏯️ TOGGLE KEYS"
        },
        "CycleAndSend": {
            "args": [
                [5, ["1", "2"]],
                [6, ["^+2", "^+3"]],
                [7, ["{Space}", "{1}"]],
                [8, ["v", "h"]]
            ],
            "description": "Toggle between sending different key combinations based on the assigned arguments.",
            "hotkeys": [
                {"key": "F20"},
                {"key": "F21"},
                {"key": "F22"},
                {"key": "F23"}
            ],
            "section": "⏯️ TOGGLE KEYS"
        },
        "RunFunctions": {
            "description": "Run Specific Function with arguments",
            "hotkeys": [
                {"key": "#p", "condition": [["GetOption", [1]]]},
                {"key": "#m"},
                {"key": "1", "condition": [["GetOption", [4]]]},
                {"key": "2", "condition": [["GetOption", [4]]]},
                {"key": "3", "condition": [["GetOption", [4]]]},
                {"key": "z", "condition": [["GetOption", [4]]]},
                {"key": "x", "condition": [["GetOption", [4]]]},
                {"key": "c", "condition": [["GetOption", [4]]]},
                {"key": "4", "condition": [["GetOption", [4]]]},
                {"key": "!r", "condition": [["GetOption", [4]]]},
                {"key": "XButton1", "condition": [["GetWindowStatus", [1, "ahk_exe IntoTheDeadOurDarkestDays.exe"]]]},
                {"key": "XButton2", "condition": [["GetWindowStatus", [1, "ahk_exe IntoTheDeadOurDarkestDays.exe"]]]}
            ],
            "args": [
                [["Run", "*RunAs pwsh"]],
                [["Run", ["pwsh -NoExit -Command \".\\mysql.exe -ujackb -p;\"", "D:\\2. Program Files\\MySQL\\bin"]]],
                [["ClickAndSleep", [1336, 624, -1, true, true]]],
                [["ClickAndSleep", [1438, 564, -1, true, false]]],
                [["ClickAndSleep", [1537, 617, -1, true, false]]],
                [["ClickAndSleep", [671, 611, -1, true, true]]],
                [["ClickAndSleep", [734, 610, -1, true, true]]],
                [["ClickAndSleep", [1534, 414, -1, true, false]]],
                [["ClickAndSleep", [1346, 510, -1, true, false]]],
                [
                    ["Send", ["{Esc}"]],
                    ["Sleep", [1000]],
                    ["ClickAndSleep", [803, 754, 700]],
                    ["ClickAndSleep", [603, 537, 2000]],
                    ["ClickAndSleep", [798, 811, 2000]],
                    ["ClickAndSleep", [990, 425, 2000]],
                    ["ClickAndSleep", [1146, 609, 4000]],
                    ["ClickAndSleep", [637, 671, 1000]],
                    ["ClickAndSleep", [1238, 799]]
                ],
                [
                    ["Send", ["{Tab}"]],
                    ["Sleep", [100]],
                    ["Send", ["r"]],
                    ["Send", ["{Tab}"]]
                ],
                [
                    ["Send", ["{Tab}"]],
                    ["Sleep", [700]],
                    ["Send", ["r"]],
                    ["Send", ["{Tab}"]]
                ]
            ],
            "section": "✨ Run"
        },
        "ChangeLang": {
            "description": "Switch between Language Layout: Vietnamese/English.",
            "hotkeys": [{ "key": "CapsLock", "condition": [["GetOption", [1]]] }],
            "section": "🛠️ SYSTEM CONFIGURATIONS"
        },
        "ConfigureDrawboardPDF": {
            "args": [1, 2],
            "description": "Configure settings for Drawboard PDF with two modes.",
            "hotkeys": [
                {"key": "^!c", "condition": [["GetWindowStatus", [1, "Drawboard PDF"]]]},
                {"key": "^!+c", "condition": [["GetWindowStatus", [1, "Drawboard PDF"]]]}
            ],
            "section": "🖥️ DEVICES SETTINGS"
        },
        "ConfigureMonitorSettings": {
            "args": [2, 3, 1],
            "description": "Configure monitor settings based on the argument value.",
            "hotkeys": [
                {"key": "+!1", "condition": [["GetWindowStatus", [0, "ahk_exe Code.exe"]]]},
                {"key": "+!2", "condition": [["GetWindowStatus", [0, "ahk_exe Code.exe"]]]},
                {"key": "+!3", "condition": [["GetWindowStatus", [0, "ahk_exe Code.exe"]]]}
            ],
            "section": "🖥️ DEVICES SETTINGS"
        },
        "ConfigureOneNote": {
            "args": [1, 2, 3, 4],
            "description": "Configure OneNote with different arguments (1 to 4). The Space and Ctrl+Space also work as toggles.",
            "hotkeys": [
                {"key": "1", "condition": ["GetScriptStatus"]},
                {"key": "2", "condition": ["GetScriptStatus"]},
                {"key": "3", "condition": ["GetScriptStatus"]},
                {"key": "4", "condition": ["GetScriptStatus"]}
            ],
            "hasSimilar": true,
            "section": "🖥️ DEVICES SETTINGS"
        },
        "ConfigurePenSettings": {
            "args": [1, 2],
            "description": "Configure pen settings for two different modes.",
            "hotkeys": [
                {"key": "+!q"},
                {"key": "+!e"}
            ],
            "section": "🖥️ DEVICES SETTINGS"
        },
        "CopyProcessDirectory": {
            "description": "Copy the directory of the active process and display the path in the tooltip.",
            "hotkeys": [
                {"key": "#^c"}
            ],
            "section": "⚡ UTILITIES"
        },
        "InputBoxForAutoSendToggle": {
            "description": "Toggle auto-send feature for continuous key input based on user input in a dialog box.",
            "hotkeys": [
                {"key": "!+s", "condition": ["GetScriptStatus"]}
            ],
            "section": "⚡ UTILITIES"
        },
        "MoveMouseByPixels": {
            "description": "Move the mouse cursor by a specified number of pixels.",
            "args": [
                ["i", "k", "j", "l", "Alt", 5],
                ["i", "k", "j", "l", "Alt", 5],
                ["i", "k", "j", "l", "Alt", 5],
                ["i", "k", "j", "l", "Alt", 5]
            ],
            "hotkeys": [
                {"key": "!i", "condition": [["GetOption", 1]]},
                {"key": "!j", "condition": [["GetOption", 1]]},
                {"key": "!k", "condition": [["GetOption", 1]]},
                {"key": "!l", "condition": [["GetOption", 1]]}
            ],
            "section": "🤖 SIMULATION"
        },
        "TimerUI": {
            "description": "Quick Set Coundown via FlowLauncher.",
            "hotkeys": [
                {"key": "!+t", "condition": [["GetOption", 1]]}
            ],
            "section": "⚡ UTILITIES"
        },
        "ToggleProjectMode": {
            "description": "Switch between Project Mode: Extend/Second Screen Only.",
            "hotkeys": [
                {"key": "#+p", "condition": [["GetOption", 1]]}
            ],
            "section": "🛠️ SYSTEM CONFIGURATIONS"
        },
        "options.Toggle": {
            "description": "Show/Hide the Options menu to Enable/Disable Hotkeys.",
            "hotkeys": [
                {"key": "F1"}
            ],
            "section": "💡 ADDITIONAL FEATURES"
        },
        "overlay.ToggleScript": {
            "description": "Toggle the activation and deactivation of the script, enabling or disabling hotkeys.",
            "hotkeys": [
                {"key": "^!x"}
            ],
            "section": "💡 ADDITIONAL FEATURES"
        },
        "overlay.ToggleVisibility": {
            "description": "Toggle visibility of the StatusOverlay for the script.",
