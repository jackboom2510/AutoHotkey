{
    "#ClickTracker": {
        "ClickTrackerObj.ToggleTracking": {
            "description": "Initializes tracking by clearing previous data, setting tracking flags, and minimizing the GUI window.",
            "hotkeys": [
                {"key": "!r"}
            ],
            "section": "⚙️ TRACKING SETTINGS"
        },
        "ClickTrackerObj.Track": {
            "description": "Captures and stores mouse click coordinates, along with window information on the first click during tracking.",
            "hotkeys": [
                {"key": "MButton", "condition": "StartTracking"}
            ],
            "section": "🖱️ ClickTracking"
        }
    },
    "#Macros": {
        "Send": { 
            "description": "Send specific key combinations based on the hotkey pressed.",
            "hotkeys": {
                "a": {"key": "{WheelLeft}", "condition": ["GetScriptStatus"]},
                "d": {"key": "{WheelRight}", "condition": ["GetScriptStatus"]},
                "s": {"key": "{WheelDown}", "condition": ["GetScriptStatus"]},
                "w": {"key": "{WheelUp}", "condition": ["GetScriptStatus"]},
                "^!e": {"key": "^{WheelUp}", "condition": ["GetScriptStatus"]},
                "^!q": {"key": "^{WheelDown}", "condition": ["GetScriptStatus"]},
                "^!s": {"key": "{PgDn}", "condition": ["GetScriptStatus"]},
                "^!w": {"key": "{PgUp}", "condition": ["GetScriptStatus"]},
                "^e": {"key": "^{=}", "condition": ["GetScriptStatus"]},
                "^q": {"key": "^{-}", "condition": ["GetScriptStatus"]},
                "!a": {"key": "{Left}", "condition": [["GetOption", 3]]},
                "!d": {"key": "{Right}", "condition": [["GetOption", 3]]},
                "!s": {"key": "{Down}", "condition": [["GetOption", 3]]},
                "!w": {"key": "{Up}", "condition": [["GetOption", 3]]},
                "!^a": {"key": "^{Left}", "condition": [["GetOption", 3]]},
                "!^d": {"key": "^{Right}", "condition": [["GetOption", 3]]},
                "!^s": {"key": "^{Down}", "condition": [["GetOption", 3]]},
                "!^w": {"key": "^{Up}", "condition": [["GetOption", 3]]},
                "XButton2 & WheelDown": {"key": "{Left}", "condition": [["GetOption", 1]]},
                "XButton2 & WheelUp": {"key": "{Right}", "condition": [["GetOption", 1]]},
                "XButton1 & WheelDown": {"key": "{Down}", "condition": [["GetOption", 1]]},
                "XButton1 & WheelUp": {"key": "{Up}", "condition": [["GetOption", 1]]},
                "XButton1 & LButton": {"key": "{XButton1}", "condition": [["GetOption", 1]]},
                "XButton1 & RButton": {"key": "{XButton2}", "condition": [["GetOption", 1]]},
                "^XButton1": {"key": "{XButton1}", "condition": [["GetOption", 1]]},
                "^XButton2": {"key": "{XButton2}", "condition": [["GetOption", 1]]},
                "!XButton1": {"key": "{F10}", "condition": [["GetWindowStatus", [1, "ahk_exe Code.exe"]]]},
                "!XButton2": {"key": "{F11}", "condition": [["GetWindowStatus", [1, "ahk_exe Code.exe"]]]},
                "!+w": {"key": "+{Home}"},
                "!+d": {"key": "+{Home}{Del}"},
                "+Space": {"key": "_", "condition": [["GetOption", 1]]},
                "+Backspace": {"key": "+^{Right}{Del}", "condition": [["GetOption", 1]]},
                "!x": {"key": ",", "condition": [["GetWindowStatus", [1, "TechSmith Camtasia 2025"]]]},
                "!z": {"key": ".", "condition": [["GetWindowStatus", [1, "TechSmith Camtasia 2025"]]]},
                "!q": {"key": "{BackSpace}", "condition": [["GetOption", 1]]},
                "!^q": {"key": "^{Backspace}", "condition": [["GetOption", 1]]},
                "!e": {"key": "{Enter}", "condition": [["GetOption", 1]]},
                "!^e": {"key": "^{Enter}", "condition": [["GetOption", 1]]},
                "!+i": {"key": "{WheelUp}", "condition": [["GetOption", 1]]},
                "!+k": {"key": "{WheelDown}", "condition": [["GetOption", 1]]},
                "!+j": {"key": "{WheelLeft}", "condition": [["GetOption", 1]]},
                "!+l": {"key": "{WheelRight}", "condition": [["GetOption", 1]]},
                "!n": {"key": "{Click}", "condition": [["GetOption", 1]]},
                "!'": {"key": "{End}{Enter}", "condition": [["GetOption", 1]]},
                "!End": {"key": "{WheelDown}", "condition": [["GetOption", 1]]},
                "!Home": {"key": "{WheelUp}", "condition": [["GetOption", 1]]},
                "j": {"key": "z", "condition": [["GetWindowStatus", [1, "Stick It To The Stickman"]]]},
                "k": {"key": "x", "condition": [["GetWindowStatus", [1, "Stick It To The Stickman"]]]},
                "l": {"key": "c", "condition": [["GetWindowStatus", [1, "Stick It To The Stickman"]]]}

            },
            "section": "🤖 SIMULATION"
        },
        "Click": {
            "args": ["R", "M"],
            "hotkeys": [
                {"key": "!m", "condition": [["GetOption", 1]]},
                {"key": "!,", "condition": [["GetOption", 1]]}
            ],
            "hasSimilar": true,
            "section": "🤖 SIMULATION"
        },
        "CycleAndExecute": {
            "args": [
                [1, [["ConfigureOneNote", [2]], ["ConfigureOneNote", [3]]]],
                [2, [["ConfigureOneNote", [1]], ["ConfigurleOneNote", [2]]]],
                [3, [["ConfigureOneNote", [1]], ["ConfigureOneNote", [5]]]],
                [4, [["Send", ["{Click D}"]], ["Send", ["{Click U}"]]]],
                [5, [["Send", ["{Click D}"]], ["Send", ["{Click U}"]]]],
                [6, [["Click", ["R D"]], ["Click", ["R U"]]]]
            ],
            "description": "Cycle And Execute through different configurations.",
            "hotkeys": [ 
                {"key": "F21"},
                {"key": "Space", "condition": [["GetScriptStatus"], ["GetWindowStatus", [1, "OneNote"]]]},
                {"key": "^Space", "condition": [["GetScriptStatus"], ["GetWindowStatus", [1, "OneNote"]]]},
                {"key": "!+n", "condition": [["GetOption", 1]]},
                {"key": "XButton2 & MButton", "condition": [["GetOption", 1]]},
                {"key": "!+m", "condition": [["GetOption", 1]]}
            ],
            "hasSimilar": true,
            "section": "⏯️ TOGGLE KEYS"
        },
        "CycleAndSend": {
            "args": [
                [5, ["{Space}", "{1}"]],
                [6, ["^+2", "^+3"]],
                [7, ["1", "2"]],
                [8, ["v", "h"]]
            ],
            "description": "Toggle between sending different key combinations based on the assigned arguments.",
            "hotkeys": [
                {"key": "F20"},
                {"key": "F22"},
                {"key": "F23"},
                {"key": "F24"}
            ],
            "hasSimilar": true,
            "section": "⏯️ TOGGLE KEYS"
        },
        "UserFunc.uCallIf": {
            "description": "Call a user-defined function if a condition is met.",
            "args": [
                [
                    "moveOverlay.ToggleScript",
                    ["DynamicSet", "moveDistance", 15],
                    ["DynamicSet", "moveDistance", 5]
                ],
                [
                    "moveOverlay.ToggleScript",
                    ["DynamicSet", "moveDistance", 20],
                    ["DynamicSet", "moveDistance", 10]
                ]
            ],
            "hotkeys": [
                {"key": "!;", "condition": [["GetOption", 1]]},
                {"key": "!+;", "condition": [["GetOption", 1]]}
            ],
            "hasSimilar": true,
            "section": "✨ Run"
        },
        "UserFunc.uRun": {
            "description": "Run Specific Function with arguments",
            "hotkeys": [
                {"key": "#p", "condition": [["GetOption", 1]]},
                {"key": "#m"},
                {"key": "XButton1", "condition": [["GetWindowStatus", 1, "ahk_exe IntoTheDeadOurDarkestDays.exe"]]},
                {"key": "XButton2", "condition": [["GetWindowStatus", 1, "ahk_exe IntoTheDeadOurDarkestDays.exe"]]}
            ],
            "args": [
                [["Run", "*RunAs pwsh"]],
                [
                    ["Run",
                    "pwsh -NoExit -Command \".\\mysql.exe -ujackb -p;\"",
                    "D:\\2. Program Files\\MySQL\\bin"]
                ],
                [
                    ["Send", "{Tab}"],
                    ["Sleep", 100],
                    ["Send", "r"],
                    ["Send", "{Tab}"]
                ],
                [
                    ["Send", "{Tab}"],
                    ["Sleep", 700],
                    ["Send", "r"],
                    ["Send", "{Tab}"]
                ]
            ],
            "hasSimilar": true,
            "section": "✨ Run"
        },
        "GoogleTranslate": {
            "description": "Translate selected text using Google Translate API and display the result in a TrayTip.",
            "args": [false, true, true],
            "hotkeys": [
                {"key": "!t", "condition": [["GetOption", 1]]},
                {"key": "!+t", "condition": [["GetOption", 1]]},
                {"key": "XButton2 & RButton", "condition": [["GetOption", 1]]}
            ],
            "section": "⚡ UTILITIES"
        },
        "PowerToyRun": {
            "description": "Search for selected text using PowerToy Run.",
            "hotkeys": [
                {"key": "XButton2 & LButton", "condition": [["GetOption", 1]]},
                {"key": "!f", "condition": [["GetOption", 1]]},
                {"key": "!^t", "condition": [["GetOption", 1]]}
            ],
            "args": [
